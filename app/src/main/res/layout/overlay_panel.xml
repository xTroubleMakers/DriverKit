<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="310dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_dark"
    android:orientation="vertical">

    <!-- HEADER (drag handle) -->
    <LinearLayout
        android:id="@+id/header"
        style="@style/OvRow"
        android:paddingVertical="12dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_indigo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/panel_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:text="–"
            android:textColor="#C7D2FE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FCA5A5"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/panelScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <TextView style="@style/OvSection" android:text="@string/sec_today" />

            <LinearLayout style="@style/OvRow">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#818CF8"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />

                    <ProgressBar
                        android:id="@+id/progressTarget"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressBackgroundTint="#334155"
                        android:progressTint="#4F46E5" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/OvSection" android:text="@string/sec_income" />

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_auto_catch" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoCatch"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_target" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swTarget"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_per_app" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swPerApp"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <TextView style="@style/OvSection" android:text="@string/sec_break" />

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_auto_break" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoBreak"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_drink" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swDrink"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_idle" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swIdle"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <TextView style="@style/OvSection" android:text="@string/sec_optin" />

            <LinearLayout style="@style/OvRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/row_speed"
                        android:textColor="#F1F5F9"
                        android:textSize="13sp" />

                    <TextView style="@style/OvNote" android:text="@string/note_need_location" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSpeed"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/row_sos"
                        android:textColor="#F1F5F9"
                        android:textSize="13sp" />

                    <TextView style="@style/OvNote" android:text="@string/note_need_loc_sms" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSos"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <TextView style="@style/OvSection" android:text="@string/sec_display" />

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_mini" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swMini"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/OvRow">
                <TextView style="@style/OvLabel" android:text="@string/row_autohide" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoHide"
                    style="@style/OvSwitch" />
            </LinearLayout>

            <LinearLayout
                style="@style/OvRow"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_opacity"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="40"
                    android:valueTo="100" />
            </LinearLayout>

            <LinearLayout
                style="@style/OvRow"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/btnShiftReset"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_soft"
                    android:gravity="center"
                    android:text="@string/act_reset_shift"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSos"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_danger"
                    android:gravity="center"
                    android:text="@string/act_sos"
                    android:textColor="#FECACA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
